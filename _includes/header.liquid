<a class="skip-link" href="#main-content">Skip to content</a>
<header class="site-header">
  <nav class="site-nav container" aria-label="Main navigation">
    <a class="site-monogram" href="{{ '/' | relative_url }}" aria-label="Zhengyang Qi — home">JQ<span aria-hidden="true">.</span></a>
    <ul class="site-nav-links">
      <li>
        <a
          href="{{ '/' | relative_url }}"
          {% if page.permalink == '/' %}
            aria-current="page"
          {% endif %}
          >About</a
        >
      </li>
      {% assign sorted_pages = site.pages | sort: 'nav_order' %}
      {% for p in sorted_pages %}
        {% if p.nav and p.autogen == null %}
          {% assign destination = p.redirect | default: p.url %}
          <li>
            <a
              href="{{ destination | relative_url }}"
              {% if page.url contains p.url %}
                aria-current="page"
              {% endif -%}
              {% if p.permalink == '/cv/' %}
                class="nav-cv"
              {% endif %}
            >
              {{ p.nav_title | default: p.title -}}
              {%- if p.permalink == '/cv/' -%}
                <span aria-hidden="true"> ↗</span>
              {%- endif %}
            </a>
          </li>
        {% endif %}
      {% endfor %}
    </ul>
  </nav>
</header>
