{% assign project_href = project.redirect %}
{% if project_href == blank %}
  {% assign project_href = project.url | relative_url %}
{% endif %}
<article class="project-entry">
  <h2 class="project-entry-title">
    <a href="{{ project_href }}">{{ project.title }}</a>
  </h2>
  {% if project.eyebrow or project.category %}
    <p class="project-entry-meta">{{ project.eyebrow | default: project.category }}</p>
  {% endif %}
  <p class="project-entry-summary">{{ project.description }}</p>
  {% if project.highlight %}
    <p class="project-entry-highlight"><strong>Highlight:</strong> {{ project.highlight }}</p>
  {% endif %}
  {% if project.stack %}
    <p class="project-entry-stack">
      <strong>Tools:</strong>
      {% for item in project.stack %}
        {{ item }}{% unless forloop.last %}, {% endunless %}
      {% endfor %}
    </p>
  {% endif %}
  <p class="project-entry-links">
    <a href="{{ project_href }}">{% if project.redirect %}Website{% else %}Read more{% endif %}</a>
  </p>
</article>
